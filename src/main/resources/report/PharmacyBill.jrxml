	<parameter name="p_orderId" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    od.OrderID, 
    od.ItemCode, 
    i.Name, 
    od.orderQuantity, 
    i.UnitPrice, 
    (od.orderQuantity * i.UnitPrice) AS Amount
FROM orderdetail od
JOIN item i ON od.ItemCode = i.ItemCode
WHERE od.OrderID = $P{p_orderId}]]>
	</queryString>
